<form class="world-translator-form">
    {{!-- Entity Type Tabs --}}
    <div class="entity-type-tabs">
        {{#each entityTypes}}
        <button type="button" class="entity-type-tab {{#if (eq this.id ../entityType)}}active{{/if}}"
            data-type="{{this.id}}">
            <i class="fas {{this.icon}}"></i> {{this.name}}
        </button>
        {{/each}}
    </div>

    {{!-- Dictionary Section --}}
    <div class="dictionary-section">
        <h3><i class="fas fa-book"></i> {{localize "COMPENDIUM_TRANSLATOR.UI.Dictionary.Title"}}</h3>
        {{#if isPF2eRuAvailable}}
        <button type="button" class="load-dictionary">
            <i class="fas fa-download"></i> {{localize "COMPENDIUM_TRANSLATOR.UI.Dictionary.LoadPf2eRu"}}
        </button>
        {{#if dictionary.loaded}}
        <span class="dictionary-status">✓ {{dictionary.count}} {{localize
            "COMPENDIUM_TRANSLATOR.UI.Dictionary.TermsLoaded"}}</span>
        {{/if}}
        {{else}}
        <span class="warning">{{localize "COMPENDIUM_TRANSLATOR.UI.Dictionary.NotFound"}}</span>
        {{/if}}
    </div>

    {{!-- Stats --}}
    <div class="stats-bar">
        <span>{{localize "COMPENDIUM_TRANSLATOR.UI.Stats.Total"}}: {{stats.total}}</span>
        <span>{{localize "COMPENDIUM_TRANSLATOR.UI.Stats.Translatable"}}: {{stats.translatable}}</span>
        <span>{{localize "COMPENDIUM_TRANSLATOR.UI.Stats.Translated"}}: {{stats.translated}}</span>
        <span>{{localize "COMPENDIUM_TRANSLATOR.UI.Stats.Remaining"}}: {{stats.remaining}}</span>
    </div>

    {{!-- Entity List --}}
    <div class="entity-list">
        <div class="list-header">
            <label><strong>{{localize "COMPENDIUM_TRANSLATOR.UI.Selection.SelectEntities"}}</strong></label>
            <div class="list-actions">
                <button type="button" class="select-all">{{localize
                    "COMPENDIUM_TRANSLATOR.UI.Selection.SelectAll"}}</button>
                <button type="button" class="select-untranslated">{{localize
                    "COMPENDIUM_TRANSLATOR.UI.Selection.SelectUntranslated"}}</button>
                <button type="button" class="deselect-all">{{localize
                    "COMPENDIUM_TRANSLATOR.UI.Selection.DeselectAll"}}</button>
            </div>
        </div>

        <div class="entity-items">
            {{#each entities}}
            <div class="entity-item {{#if this.isTranslated}}translated{{/if}}">
                <label>
                    <input type="checkbox" class="entity-checkbox" data-id="{{this.id}}" {{#if
                        this.isSelected}}checked{{/if}}>
                    <span class="entity-name">{{this.name}}</span>
                    {{#if this.isTranslated}}
                    <span class="translated-badge" title="{{localize "
                        COMPENDIUM_TRANSLATOR.UI.Selection.AlreadyTranslated"}}">✓</span>
                    <button type="button" class="restore-backup" data-id="{{this.id}}" title="{{localize "
                        COMPENDIUM_TRANSLATOR.UI.Selection.RestoreOriginal"}}">
                        <i class="fas fa-undo"></i>
                    </button>
                    {{/if}}
                    <span class="entity-info">{{this.contentPreview}}</span>
                </label>
            </div>
            {{/each}}
        </div>
    </div>

    {{!-- Workflow Section --}}
    <div class="workflow-section">
        {{!-- Step 1: Extract --}}
        <div class="workflow-step">
            <h4>{{localize "COMPENDIUM_TRANSLATOR.UI.Workflow.Step1"}}</h4>
            <button type="button" class="extract-selected" {{#unless hasSelection}}disabled{{/unless}}>
                <i class="fas fa-file-export"></i> {{localize "COMPENDIUM_TRANSLATOR.UI.Workflow.ExtractSelected"}}
                ({{selectedEntities.size}})
            </button>
        </div>

        {{!-- Step 2: Generate Prompt --}}
        {{#if (eq progress.status "extracted")}}
        <div class="workflow-step">
            <h4>{{localize "COMPENDIUM_TRANSLATOR.UI.Workflow.Step2"}}</h4>
            <button type="button" class="generate-prompt">
                <i class="fas fa-magic"></i> {{localize "COMPENDIUM_TRANSLATOR.UI.Workflow.GeneratePrompt"}}
            </button>
        </div>
        {{/if}}

        {{!-- Step 3: Copy & Paste --}}
        {{#if generatedPrompt}}
        <div class="workflow-step">
            <h4>{{localize "COMPENDIUM_TRANSLATOR.UI.Workflow.Step3"}}</h4>
            <div class="prompt-preview">
                <textarea readonly rows="8">{{generatedPrompt}}</textarea>
            </div>
            <button type="button" class="copy-prompt">
                <i class="fas fa-copy"></i> {{localize "COMPENDIUM_TRANSLATOR.UI.Workflow.CopyPrompt"}}
            </button>
        </div>

        <div class="workflow-step">
            <h4>{{localize "COMPENDIUM_TRANSLATOR.UI.Workflow.Step4"}}</h4>
            <textarea name="ai-response" rows="8" placeholder="{{localize "
                COMPENDIUM_TRANSLATOR.UI.Workflow.PastePlaceholder"}}"></textarea>
            <button type="button" class="process-response">
                <i class="fas fa-cog"></i> {{localize "COMPENDIUM_TRANSLATOR.UI.Workflow.ProcessResponse"}}
            </button>
        </div>
        {{/if}}

        {{!-- Step 5: Spell-check (Optional) --}}
        {{#if (eq progress.status "ready-to-apply")}}
        <div class="workflow-step">
            <h4>{{localize "COMPENDIUM_TRANSLATOR.UI.Workflow.Step5"}}</h4>
            <button type="button" class="generate-spellcheck">
                <i class="fas fa-spell-check"></i> {{localize "COMPENDIUM_TRANSLATOR.UI.Workflow.GenerateSpellcheck"}}
            </button>
        </div>

        {{!-- Step 6: Apply --}}
        <div class="workflow-step">
            <h4>{{localize "COMPENDIUM_TRANSLATOR.UI.Workflow.Step6"}}</h4>
            <p class="warning-text"><i class="fas fa-exclamation-triangle"></i> {{localize
                "COMPENDIUM_TRANSLATOR.Warnings.BackupWarning"}}</p>
            <button type="button" class="apply-translation">
                <i class="fas fa-check"></i> {{localize "COMPENDIUM_TRANSLATOR.UI.Workflow.ApplyToEntities"}}
            </button>
        </div>
        {{/if}}
    </div>

    {{!-- Progress --}}
    {{#unless (eq progress.status "idle")}}
    <div class="progress-section">
        <p><i class="fas fa-spinner fa-spin"></i> {{progress.status}}</p>
    </div>
    {{/unless}}

    {{!-- Success Message --}}
    {{#if (eq progress.status "complete")}}
    <div class="success-section">
        <p><i class="fas fa-check-circle"></i> {{localize "COMPENDIUM_TRANSLATOR.UI.Success.TranslationApplied"}}</p>
    </div>
    {{/if}}
</form>