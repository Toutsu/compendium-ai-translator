{
    "id": "compendium-ai-translator",
    "title": "Compendium AI Translator for Babele",
    "version": "1.0.0",
    "description": "AI-powered translation tool for Foundry VTT compendiums. Generates Babele-compatible translation files for all entity types (Actors, Items, Journals, etc.). Supports multiple AI providers: Gemini, ChatGPT, Claude, Copilot, and Perplexity.",
    "authors": [
        {
            "name": "Compendium Translator Team",
            "url": "https://github.com/Toutsu/compendium-ai-translator",
            "discord": ""
        }
    ],
    "url": "https://github.com/Toutsu/compendium-ai-translator",
    "manifest": "https://github.com/Toutsu/compendium-ai-translator/releases/latest/download/module.json",
    "download": "https://github.com/Toutsu/compendium-ai-translator/releases/latest/download/module.zip",
    "compatibility": {
        "minimum": "12",
        "verified": "13",
        "maximum": "13"
    },
    "relationships": {
        "requires": [
            {
                "id": "babele",
                "type": "module",
                "manifest": "https://gitlab.com/riccisi/foundryvtt-babele/-/raw/master/module/module.json",
                "compatibility": {
                    "minimum": "3.0.0"
                }
            }
        ]
    },
    "esmodules": [
        "scripts/main.js",
        "scripts/FieldMapper.js",
        "scripts/EntityExtractor.js",
        "scripts/TranslationService.js",
        "scripts/BabeleGenerator.js",
        "scripts/TranslationUI.js",
        "scripts/DictionaryLoader.js",
        "scripts/TermReplacer.js",
        "scripts/PromptGenerator.js",
        "scripts/WorldEntityExtractor.js",
        "scripts/EntityUpdater.js",
        "scripts/WorldTranslationUI.js"
    ],
    "styles": [
        "styles/translator.css"
    ],
    "languages": [
        {
            "lang": "en",
            "name": "English",
            "path": "languages/en.json"
        },
        {
            "lang": "ru",
            "name": "Русский",
            "path": "languages/ru.json"
        }
    ],
    "license": "LICENSE",
    "readme": "README.md"
}